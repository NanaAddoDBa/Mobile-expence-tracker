{
  "name": "expense-tracker-api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node --env-file-if-exists=.env ./node_modules/@nestjs/cli/bin/nest.js start",
    "start:dev": "node --env-file-if-exists=.env ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "build": "node ./node_modules/@nestjs/cli/bin/nest.js build",
    "test": "node ./node_modules/jest/bin/jest.js",
    "test:e2e": "node ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "prisma:generate": "node --env-file=.env.example --env-file-if-exists=.env ./node_modules/prisma/build/index.js generate",
    "prisma:format": "node --env-file=.env.example --env-file-if-exists=.env ./node_modules/prisma/build/index.js format",
    "prisma:validate": "node --env-file=.env.example --env-file-if-exists=.env ./node_modules/prisma/build/index.js validate",
    "prisma:migrate:dev": "node --env-file=.env.example --env-file-if-exists=.env ./node_modules/prisma/build/index.js migrate dev",
    "prisma:studio": "node --env-file=.env.example --env-file-if-exists=.env ./node_modules/prisma/build/index.js studio"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.24",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.24",
    "@nestjs/platform-express": "^11.1.24",
    "@prisma/client": "^6.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "expense-tracker-budget-manager": "file:..",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "setupFiles": [
      "reflect-metadata"
    ],
    "testEnvironment": "node"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/testing": "^11.1.24",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/supertest": "^7.2.0",
    "jest": "^30.4.2",
    "prisma": "^6.19.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.6.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  }
}
