NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://expense_tracker:use-a-secret@database.example.com:5432/expense_tracker?schema=public&sslmode=require
FRONTEND_ORIGIN=https://expenses.example.com
APP_PUBLIC_URL=https://expenses.example.com
PUBLIC_API_URL=https://expenses.example.com
SESSION_TTL_DAYS=7
COOKIE_SECURE=true
TRUST_PROXY=1
CSRF_SECRET=use-a-unique-random-secret-with-at-least-32-characters
REQUEST_BODY_LIMIT=100kb
BCRYPT_ROUNDS=12
GOOGLE_CLIENT_ID=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Expense Tracker <accounts@example.com>
SMTP_CONNECTION_TIMEOUT_MS=10000
GOCARDLESS_BANK_DATA_BASE_URL=https://bankaccountdata.gocardless.com/api/v2
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
GOCARDLESS_DEFAULT_COUNTRY=DE
GOCARDLESS_DEFAULT_INSTITUTION_ID=SANDBOXFINANCE_SFIN0000
BANK_CONNECTIONS_ENABLED=true
BANK_SYNC_ENABLED=true
BANK_SYNC_INTERVAL_MINUTES=360
BANK_SYNC_BATCH_SIZE=10
BANK_SYNC_LOCK_MINUTES=10
GOCARDLESS_REQUEST_TIMEOUT_MS=10000
GOCARDLESS_MAX_RETRIES=2
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=35000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
AUTH_TOKEN_RETENTION_DAYS=7
SESSION_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=365
