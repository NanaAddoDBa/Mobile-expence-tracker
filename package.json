{
	"name": "expense-tracker-budget-manager",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "node ./node_modules/vite/bin/vite.js --configLoader runner --port=3000 --host=0.0.0.0",
		"build": "node ./node_modules/vite/bin/vite.js build --configLoader runner",
		"preview": "node ./node_modules/vite/bin/vite.js preview --configLoader runner",
		"clean": "rm -rf dist server.js",
		"lint": "node ./node_modules/eslint/bin/eslint.js .",
		"lint:styles": "node scripts/audit-tailwind-classes.mjs",
		"typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
		"test": "node ./node_modules/vitest/vitest.mjs run --configLoader runner",
		"test:watch": "node ./node_modules/vitest/vitest.mjs --configLoader runner"
	},
	"dependencies": {
		"d3": "^7.9.0",
		"lucide-react": "^0.546.0",
		"react": "^19.0.1",
		"react-dom": "^19.0.1"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"@tailwindcss/vite": "^4.1.14",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/d3": "^7.4.3",
		"@types/node": "^22.14.0",
		"@types/react": "^19.2.16",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.0.4",
		"autoprefixer": "^10.4.21",
		"esbuild": "^0.28.1",
		"eslint": "^9.39.1",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-react-refresh": "^0.4.24",
		"globals": "^16.5.0",
		"jsdom": "^29.1.1",
		"tailwindcss": "^4.1.14",
		"tsx": "^4.21.0",
		"typescript": "~5.8.2",
		"typescript-eslint": "^8.48.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	}
}
